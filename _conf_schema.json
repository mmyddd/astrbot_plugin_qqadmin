{
  "default": {
    "description": "默认值配置",
    "hint": "以下配置项为每个群的默认值，可在群内用命令“群管配置”查看或修改；用“群管重置”可恢复默认值",
    "obvious_hint": true,
    "type": "object",
    "items": {
      "inactive_days": {
        "description": "未发言天数阈值",
        "hint": "命令“清理群友”未指定天数时使用的默认值。官方 API 不提供最后发言时间，该数据由插件监听群消息在本地记录",
        "type": "int",
        "slider": {
          "min": 1,
          "max": 365,
          "step": 1
        },
        "default": 30
      }
    }
  },
  "inactive_days_limit": {
    "description": "未发言天数上限",
    "hint": "命令中可填写的最大未发言天数，防止误操作传入过大数值",
    "type": "int",
    "slider": {
      "min": 1,
      "max": 3650,
      "step": 1
    },
    "default": 365
  },
  "clear_batch_size": {
    "description": "批量移除的每批人数",
    "hint": "官方接口单次最多移除 20 人，两次请求之间会自动等待 2 秒以避免频控",
    "type": "int",
    "slider": {
      "min": 1,
      "max": 20,
      "step": 1
    },
    "default": 20
  },
  "perms": {
    "description": "指令权限管理",
    "hint": "设置各个命令的使用权限（官方 API 不提供群成员角色，这里只区分超管与普通成员）",
    "type": "object",
    "items": {
      "get_group_member_list": {
        "description": "群友信息",
        "type": "string",
        "options": [
          "超管",
          "成员"
        ],
        "default": "成员"
      },
      "clear_group_member": {
        "description": "清理群友",
        "hint": "建议仅超管可用，清理会直接移出群聊",
        "type": "string",
        "options": [
          "超管",
          "成员"
        ],
        "default": "超管"
      },
      "set_config": {
        "description": "群管配置",
        "type": "string",
        "options": [
          "超管",
          "成员"
        ],
        "default": "成员"
      },
      "reset_config": {
        "description": "群管重置",
        "type": "string",
        "options": [
          "超管",
          "成员"
        ],
        "default": "超管"
      }
    }
  }
}
